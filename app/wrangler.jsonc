{
  // Cloudflare Worker: email gate + manual approval. Name must match the Worker in the dashboard.
  "name": "helloamar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "helloamar-gate", "database_id": "dfe23b48-ab49-4792-8feb-7abfdbd72cef" }
  ],
  "vars": {
    "ADMIN_EMAIL": "amarjitmangarhia@gmail.com",
    "FROM_EMAIL": "hello@helloamar.com",
    "SITE_URL": "https://helloamar.com"
  }
}
